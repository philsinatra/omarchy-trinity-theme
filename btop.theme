# Trinity btop theme — GENERATED by scripts/genpalette.py from Omarchy's template.
# Red is kept for alarms only.
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#19191c"

# Main text color
theme[main_fg]="#dfdcd5"

# Title color for boxes
theme[title]="#dfdcd5"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c8bc88"

# Background color of selected item in processes box
theme[selected_bg]="#27384b"

# Foreground color of selected item in processes box
theme[selected_fg]="#c8bc88"

# Color of inactive/disabled text
theme[inactive_fg]="#949089"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c2bfb8"

# Background color of the percentage meters
theme[meter_bg]="#27384b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c2bfb8"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ba8fad"
theme[mem_box]="#add7b5"
theme[net_box]="#8da9c7"
theme[proc_box]="#c8bc88"

# Box divider line and small boxes line color
theme[div_line]="#949089"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#add7b5"
theme[temp_mid]="#c8bc88"
theme[temp_end]="#eb7f74"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#84c0b9"
theme[cpu_mid]="#8da9c7"
theme[cpu_end]="#ba8fad"

# Mem/Disk free meter
theme[free_start]="#ba8fad"
theme[free_mid]="#8da9c7"
theme[free_end]="#84c0b9"

# Mem/Disk cached meter
theme[cached_start]="#8da9c7"
theme[cached_mid]="#84c0b9"
theme[cached_end]="#ba8fad"

# Mem/Disk available meter
theme[available_start]="#c8bc88"
theme[available_mid]="#d29c8c"
theme[available_end]="#d29c8c"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#add7b5"
theme[used_mid]="#84c0b9"
theme[used_end]="#8da9c7"

# Download graph colors
theme[download_start]="#c8bc88"
theme[download_mid]="#d29c8c"
theme[download_end]="#d29c8c"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#add7b5"
theme[upload_mid]="#84c0b9"
theme[upload_end]="#8da9c7"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#84c0b9"
theme[process_mid]="#8da9c7"
theme[process_end]="#ba8fad"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#19191c"
theme[gradient_color_1]="#222226"
theme[gradient_color_2]="#27384b"
theme[gradient_color_3]="#949089"
theme[gradient_color_4]="#a9a69f"
theme[gradient_color_5]="#dfdcd5"
theme[gradient_color_6]="#c2bfb8"
theme[gradient_color_7]="#f4f1ec"
